{
  "name": "@danmaku-anywhere/danmaku-somewhere",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --hmr",
    "build": "pnpm build:packages && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "biome check --fix",
    "lint:ci": "biome ci",
    "type-check": "tsgo --noEmit -p tsconfig.app.json && tsgo --noEmit -p tsconfig.spec.json && tsgo --noEmit -p tsconfig.worker.json",
    "wrangler": "wrangler",
    "build:packages": "pnpm -F './packages/**' build",
    "prepare": "lefthook install",
    "fallow": "fallow"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-server": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "@danmaku-anywhere/bangumi-api": "workspace:*",
    "@danmaku-anywhere/danmaku-model": "^0.2.0",
    "@danmaku-anywhere/extension-protocol": "^0.1.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/angular-query-experimental": "^5.107.2",
    "@tanstack/angular-virtual": "^6.1.14",
    "artplayer": "^5.4.0",
    "clarity-js": "^0.8.77",
    "dexie": "^4.4.7",
    "libass-wasm": "^4.1.0",
    "material-symbols": "^0.49.0",
    "openapi-fetch": "^0.17.0",
    "postcss": "^8.5.33",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.9.1",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/ssr": "^21.2.26",
    "@biomejs/biome": "^2.6.9",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "fallow": "3.49.0",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.168.0"
  },
  "repository": "https://github.com/Danmaku-Anywhere/web",
  "packageManager": "pnpm@11.29.0"
}
